{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://findrai-zfnm.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://findrai-zfnm.onrender.com/uploads/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ]
}
