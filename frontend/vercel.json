{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://findr-ai-zh93.vercel.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://findr-ai-zh93.vercel.app/uploads/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ]
}
